<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Configurations>Debug;Release</Configurations>

        <!--The file where mod information which is required for publishing mod on PDX mods are stored-->
        <PublishConfigurationPath>Properties\PublishConfiguration.xml</PublishConfigurationPath>
    </PropertyGroup>

    <!--The .pdb ships with the mod (it is what gives players' crash reports file and line
    numbers), so the paths inside it are public. PathMap rewrites them to a repo-relative
    prefix, and SourceLink is off because its JSON records the absolute build root.-->
    <PropertyGroup>
        <PathMap>$(MSBuildProjectDirectory)\=CS2MultiplayerMod\</PathMap>
        <EnableSourceLink>false</EnableSourceLink>
        <DebugType>portable</DebugType>
    </PropertyGroup>

    <!--The per-entity occupancy/household trace lines (see Game/Diagnostics/DevTrace.cs).
    Off in a shipped build; turn them on with: dotnet build -p:MpDevTrace=true-->
    <PropertyGroup Condition="'$(MpDevTrace)' == 'true'">
        <DefineConstants>$(DefineConstants);MP_DEV_TRACE</DefineConstants>
    </PropertyGroup>

    <!--The mod's real version lives in PublishConfiguration.xml - it is what the store shows and
    what a player quotes in a report. Stamp it into the assembly so the log and the handshake can
    report it: the assembly version stays 1.0.0.0 across releases, so while that was the source
    every build introduced itself as the same version to its peer.-->
    <Target Name="StampModVersion" BeforeTargets="GetAssemblyAttributes;GenerateAssemblyInfo">
        <XmlPeek XmlInputPath="$(PublishConfigurationPath)" Query="/Publish/ModVersion/@Value">
            <Output TaskParameter="Result" PropertyName="PublishedModVersion"/>
        </XmlPeek>
        <PropertyGroup Condition="'$(PublishedModVersion)' != ''">
            <InformationalVersion>$(PublishedModVersion)</InformationalVersion>
        </PropertyGroup>
        <!--Anything but Release is a local build, and gets the second it was compiled appended as
        SemVer build metadata. That is the number the options screen and the log show for a dev
        build, and the reason it is the time and not a counter is that it needs no state in the
        repo. It changes every build, so a Debug build always recompiles this project - which is
        the point: the number proves the running game has the code that was just compiled. A
        Release build stamps the plain published version, so a public build shows clean numbers,
        and nothing here reaches the wire (the handshake compares the release part only).-->
        <PropertyGroup Condition="'$(Configuration)' != 'Release' and '$(InformationalVersion)' != ''">
            <InformationalVersion>$(InformationalVersion)+dev.$([System.DateTime]::Now.ToString("yyMMdd-HHmmss"))</InformationalVersion>
        </PropertyGroup>
    </Target>

    <!--The source commit, so a report names the exact code even for a fork or a local build that
    shares a release number. "-dirty" marks uncommitted changes; without git nothing is stamped
    and the mod reports "unknown". Never compared on the wire, only logged.-->
    <Target Name="StampBuildCommit" BeforeTargets="GetAssemblyAttributes;GenerateAssemblyInfo">
        <Exec Command="git describe --always --dirty --abbrev=12 --exclude=*"
              WorkingDirectory="$(MSBuildProjectDirectory)\.." ConsoleToMSBuild="true" IgnoreExitCode="true"
              EchoOff="true" StandardOutputImportance="low" StandardErrorImportance="low">
            <Output TaskParameter="ConsoleOutput" PropertyName="BuildCommitOutput"/>
        </Exec>
        <ItemGroup Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(BuildCommitOutput)', '^[0-9a-f]{7,40}(-dirty)?$'))">
            <AssemblyMetadata Include="CS2MP.Commit" Value="$(BuildCommitOutput)"/>
        </ItemGroup>
    </Target>

    <!--Imports must be after PropertyGroup block-->
    <Import Project="$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))\Mod.props"/>
    <Import Project="$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))\Mod.targets"/>

    <ItemGroup>
        <Reference Include="Game">
            <Private>false</Private>
        </Reference>
        <Reference Include="Colossal.Core">
            <Private>false</Private>
        </Reference>
        <Reference Include="Colossal.Collections">
            <Private>false</Private>
        </Reference>
        <Reference Include="Colossal.Logging">
            <Private>false</Private>
        </Reference>
        <Reference Include="Colossal.IO.AssetDatabase">
            <Private>false</Private>
        </Reference>
        <Reference Include="Colossal.AssetPipeline">
            <Private>false</Private>
        </Reference>
        <Reference Include="Colossal.UI">
            <Private>false</Private>
        </Reference>
        <Reference Include="Colossal.UI.Binding">
            <Private>false</Private>
        </Reference>
        <Reference Include="Colossal.Localization">
            <Private>false</Private>
        </Reference>
        <Reference Include="Colossal.Mathematics">
            <Private>false</Private>
        </Reference>
        <Reference Include="Colossal.PSI.Common">
            <Private>false</Private>
        </Reference>
        <!--No reference to Steamworks here, deliberately: the game refuses to load a mod
        whose declared references it cannot resolve, and only the Steam build of the game
        ships that assembly. The relay lives in CS2MultiplayerMod.Steam.dll instead, which
        nothing links at build time - see Game/SteamRelayBootstrap.cs.-->
        <Reference Include="Unity.InputSystem">
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.IMGUIModule">
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.TextRenderingModule">
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.PhysicsModule">
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.InputLegacyModule">
            <Private>false</Private>
        </Reference>
        <Reference Include="Unity.Burst">
            <Private>false</Private>
        </Reference>
        <Reference Include="Unity.Collections">
            <Private>false</Private>
        </Reference>
        <Reference Include="Unity.Entities">
            <Private>false</Private>
        </Reference>
        <Reference Include="Unity.Mathematics">
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <Reference Update="System">
            <Private>false</Private>
        </Reference>
        <Reference Update="System.Core">
            <Private>false</Private>
        </Reference>
        <Reference Update="System.Data">
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <None Include="$(ModPropsFile)" Link="Properties\Mod.props"/>
        <None Include="$(ModTargetsFile)" Link="Properties\Mod.targets"/>
    </ItemGroup>

    <!-- Locale files are the single source of truth per language; embed them so the
    PropertiesLocaleSource can read them at runtime. -->
    <ItemGroup>
        <EmbeddedResource Include="Localization\locales\*.properties"/>
    </ItemGroup>

    <!--The Steam relay backend builds against this assembly, so it can only be built once
    this one is done - and DeployWIP has wiped and refilled the mod folder by then, hence
    the copy into both the output and the deployed folder.-->
    <Target Name="BuildSteamBackend" AfterTargets="DeployWIP" Condition="'$(NeedBuild)'=='true'">
        <PropertyGroup>
            <SteamBackendDir>$(MSBuildProjectDirectory)\..\CS2MultiplayerMod.Steam</SteamBackendDir>
        </PropertyGroup>
        <MSBuild Projects="$(SteamBackendDir)\CS2MultiplayerMod.Steam.csproj"
                 Targets="Build" Properties="Configuration=$(Configuration)"/>
        <ItemGroup>
            <SteamBackendFiles Include="$(SteamBackendDir)\bin\$(Configuration)\net48\CS2MultiplayerMod.Steam.dll"/>
            <SteamBackendFiles Include="$(SteamBackendDir)\bin\$(Configuration)\net48\CS2MultiplayerMod.Steam.pdb"/>
        </ItemGroup>
        <Copy SourceFiles="@(SteamBackendFiles)" DestinationFolder="$(OutDir)"/>
        <Copy SourceFiles="@(SteamBackendFiles)" DestinationFolder="$(DeployDir)" Condition="Exists('$(DeployDir)')"/>
    </Target>

    <!--Build the UI module after the C# build. Must run after Mod.targets' DeployWIP
    (which wipes and refills the local mods folder) because webpack writes the compiled
    UI straight into that folder; same-event targets run in definition order, and this
    file imports Mod.targets above, so the ordering holds.-->
    <Target Name="BuildUI" AfterTargets="DeployWIP" Condition="'$(NeedBuild)'=='true'">
        <Exec Command="npm run build" WorkingDirectory="$(ProjectDir)UI"/>
        <Error Condition="!Exists('$(DeployDir)\$(TargetName).mjs')"
               Text="The multiplayer UI bundle was not generated at $(DeployDir)\$(TargetName).mjs."/>
        <!-- Keep the UI beside the DLL in bin as well as in the live/publish folder.
        Manual release archives are made from bin, and omitting this file removes the
        main-menu button, in-game button, connection overlays and milestone countdown. -->
        <ItemGroup>
            <MultiplayerUiOutput Include="$(DeployDir)\$(TargetName).mjs"/>
            <MultiplayerUiOutput Include="$(DeployDir)\$(TargetName).mjs.LICENSE.txt"
                                 Condition="Exists('$(DeployDir)\$(TargetName).mjs.LICENSE.txt')"/>
        </ItemGroup>
        <Copy SourceFiles="@(MultiplayerUiOutput)" DestinationFolder="$(OutDir)"/>
    </Target>

    <!-- Never upload an incomplete folder even when the toolchain's Update command
    deliberately skips Build/DeployWIP and publishes the existing deployment. -->
    <Target Name="ValidatePublishedUI" BeforeTargets="Publish">
        <Error Condition="!Exists('$(DeployDir)\$(TargetName).dll')"
               Text="The publish folder has not been built. Build the mod before publishing."/>
        <Error Condition="!Exists('$(DeployDir)\$(TargetName).mjs')"
               Text="The publish folder is missing $(TargetName).mjs. Build the mod before publishing."/>
    </Target>

    <!--The Burst stubs are compiled through the toolchain's cache directory and keep its
    absolute path inside them; their symbol files carry it too. Both are published as-is,
    so strip them from the deployed copy (and from bin, which is zipped by hand).-->
    <Target Name="ScrubBuildPaths" AfterTargets="BuildUI" Condition="'$(NeedBuild)'=='true'">
        <PropertyGroup>
            <ScrubScript>$(MSBuildProjectDirectory)\..\build\scrub-build-paths.ps1</ScrubScript>
        </PropertyGroup>
        <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ScrubScript)&quot; -Directory &quot;$(DeployDir)&quot;"
              Condition="Exists('$(DeployDir)')"/>
        <!--OutDir keeps its trailing slash, which would escape the closing quote.-->
        <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ScrubScript)&quot; -Directory &quot;$(MSBuildProjectDirectory)\$(OutDir.TrimEnd('\'))&quot;"/>
    </Target>

</Project>
