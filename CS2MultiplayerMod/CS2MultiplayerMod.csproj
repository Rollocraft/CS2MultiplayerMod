<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Configurations>Debug;Release</Configurations>

        <!--The file where mod information which is required for publishing mod on PDX mods are stored-->
        <PublishConfigurationPath>Properties\PublishConfiguration.xml</PublishConfigurationPath>
    </PropertyGroup>

    <!--Imports must be after PropertyGroup block-->
    <Import Project="$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))\Mod.props" Condition="Exists('$([System.Environment]::GetEnvironmentVariable(\'CSII_TOOLPATH\', \'EnvironmentVariableTarget.User\'))\Mod.props')"/>
    <Import Project="$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))\Mod.targets" Condition="Exists('$([System.Environment]::GetEnvironmentVariable(\'CSII_TOOLPATH\', \'EnvironmentVariableTarget.User\'))\Mod.targets')"/>

    <ItemGroup>
        <Reference Include="Game">
            <Private>false</Private>
        </Reference>
        <Reference Include="Colossal.Core">
            <Private>false</Private>
        </Reference>
        <Reference Include="Colossal.Collections">
            <Private>false</Private>
        </Reference>
        <Reference Include="Colossal.Logging">
            <Private>false</Private>
        </Reference>
        <Reference Include="Colossal.IO.AssetDatabase">
            <Private>false</Private>
        </Reference>
        <Reference Include="Colossal.AssetPipeline">
            <Private>false</Private>
        </Reference>
        <Reference Include="Colossal.UI">
            <Private>false</Private>
        </Reference>
        <Reference Include="Colossal.UI.Binding">
            <Private>false</Private>
        </Reference>
        <Reference Include="Colossal.Localization">
            <Private>false</Private>
        </Reference>
        <Reference Include="Colossal.Mathematics">
            <Private>false</Private>
        </Reference>
        <Reference Include="Colossal.PSI.Common">
            <Private>false</Private>
        </Reference>
        <!--No reference to Steamworks here, deliberately: the game refuses to load a mod
        whose declared references it cannot resolve, and only the Steam build of the game
        ships that assembly. The relay lives in CS2MultiplayerMod.Steam.dll instead, which
        nothing links at build time - see Game/SteamRelayBootstrap.cs.-->
        <Reference Include="Unity.InputSystem">
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.IMGUIModule">
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.TextRenderingModule">
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.PhysicsModule">
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.InputLegacyModule">
            <Private>false</Private>
        </Reference>
        <Reference Include="Unity.Burst">
            <Private>false</Private>
        </Reference>
        <Reference Include="Unity.Collections">
            <Private>false</Private>
        </Reference>
        <Reference Include="Unity.Entities">
            <Private>false</Private>
        </Reference>
        <Reference Include="Unity.Mathematics">
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <Reference Update="System">
            <Private>false</Private>
        </Reference>
        <Reference Update="System.Core">
            <Private>false</Private>
        </Reference>
        <Reference Update="System.Data">
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <None Include="$(ModPropsFile)" Link="Properties\Mod.props"/>
        <None Include="$(ModTargetsFile)" Link="Properties\Mod.targets"/>
    </ItemGroup>

    <!-- Locale files are the single source of truth per language; embed them so the
    PropertiesLocaleSource can read them at runtime. -->
    <ItemGroup>
        <EmbeddedResource Include="Localization\locales\*.properties"/>
    </ItemGroup>

    <!--The Steam relay backend builds against this assembly, so it can only be built once
    this one is done - and DeployWIP has wiped and refilled the mod folder by then, hence
    the copy into both the output and the deployed folder.-->
    <Target Name="BuildSteamBackend" AfterTargets="DeployWIP" Condition="'$(NeedBuild)'=='true'">
        <PropertyGroup>
            <SteamBackendDir>$(MSBuildProjectDirectory)\..\CS2MultiplayerMod.Steam</SteamBackendDir>
        </PropertyGroup>
        <MSBuild Projects="$(SteamBackendDir)\CS2MultiplayerMod.Steam.csproj"
                 Targets="Build" Properties="Configuration=$(Configuration)"/>
        <ItemGroup>
            <SteamBackendFiles Include="$(SteamBackendDir)\bin\$(Configuration)\net48\CS2MultiplayerMod.Steam.dll"/>
            <SteamBackendFiles Include="$(SteamBackendDir)\bin\$(Configuration)\net48\CS2MultiplayerMod.Steam.pdb"/>
        </ItemGroup>
        <Copy SourceFiles="@(SteamBackendFiles)" DestinationFolder="$(OutDir)"/>
        <Copy SourceFiles="@(SteamBackendFiles)" DestinationFolder="$(DeployDir)" Condition="Exists('$(DeployDir)')"/>
    </Target>

    <!--Build the UI module after the C# build. Must run after Mod.targets' DeployWIP
    (which wipes and refills the local mods folder) because webpack writes the compiled
    UI straight into that folder; same-event targets run in definition order, and this
    file imports Mod.targets above, so the ordering holds.-->
    <Target Name="BuildUI" AfterTargets="DeployWIP" Condition="'$(NeedBuild)'=='true'">
        <Exec Command="npm run build" WorkingDirectory="$(ProjectDir)UI"/>
    </Target>

</Project>
